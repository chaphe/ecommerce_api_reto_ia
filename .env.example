# Copia este archivo como .env y ajusta los valores. El .env no se sube al repositorio.
#
# Usa un usuario de MySQL dedicado a la app, no root. Por ejemplo:
#   CREATE USER 'ecommerce_app'@'%' IDENTIFIED BY 'una-clave-segura';
#   GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, INDEX, REFERENCES ON ecommerce_db.* TO 'ecommerce_app'@'%';
DATABASE_URL=mysql+pymysql://ecommerce_app:una-clave-segura@localhost:3306/ecommerce_db
