# Local (MySQL en el host): usa localhost.
# Docker Compose: el hostname del servicio es `db` (red bridge interna).
DATABASE_URL=mysql+pymysql://root:password123@localhost:3306/ecommerce_db
MYSQL_ROOT_PASSWORD=replace-with-a-random-root-password
MYSQL_USER=ecommerce_app
MYSQL_PASSWORD=replace-with-a-random-app-password
MYSQL_DATABASE=ecommerce_db
DISCOUNT_THRESHOLD=100
DISCOUNT_RATE=0.10
SESSION_SECRET=replace-with-a-random-32-byte-secret
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE=28800
DATABASE_AUTO_MIGRATE=false
# Optional one-time bootstrap; ignored after an admin exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
